{
  "name": "you-coder",
  "displayName": "YouCoder",
  "version": "0.0.2",
  "description": "YouTube動画のアクション区間とラベルを記録し、CSVで書き出すスポーツ映像分析ツール。",
  "author": "Kou Isaka (Kou-ISK)",
  "homepage": "https://github.com/Kou-ISK/YouCoder",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kou-ISK/YouCoder.git"
  },
  "bugs": {
    "url": "https://github.com/Kou-ISK/YouCoder/issues"
  },
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false"
  },
  "dependencies": {
    "events": "^3.3.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-draggable": "^4.4.6"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "0.0.258",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.4.21",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.6",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.3.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://www.youtube.com/*"
    ],
    "permissions": [
      "storage"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self';"
    },
    "web_accessible_resources": [
      {
        "resources": [
          "*.css"
        ],
        "matches": [
          "https://www.youtube.com/*"
        ]
      }
    ]
  },
  "packageManager": "pnpm@9.15.9"
}
